# Backend Server Configuration
PORT=5000
NODE_ENV=development

# PostgreSQL Connection
# Format: postgresql://USER:PASSWORD@HOST:PORT/DATABASE?schema=public
DATABASE_URL="postgresql://postgres:your_password_here@localhost:5432/travelai_app?schema=public"

# JWT Secret (Use a strong random string in production)
JWT_SECRET=your_super_secret_jwt_key_min_32_characters_here

# Frontend Application URL (for CORS)
FRONTEND_URL=http://localhost:5173

# Google Gemini API Key (Optional: Demo fallback mode activates automatically if empty)
GEMINI_API_KEY=
