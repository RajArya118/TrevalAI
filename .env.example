# ==========================================
# TravelAI - Root Environment Configuration Example
# Copy this file to .env or configure backend/.env and frontend/.env
# ==========================================

# PostgreSQL Database Connection
# Format: postgresql://USER:PASSWORD@HOST:PORT/DATABASE?schema=public
DATABASE_URL="postgresql://postgres:your_password_here@localhost:5432/travelai_app?schema=public"

# Backend Server Configuration
PORT=5000
NODE_ENV=development
JWT_SECRET=your_super_secret_jwt_key_min_32_characters_here

# Google Gemini API Key (Optional: Leave empty to activate built-in Demo Simulation Mode)
GEMINI_API_KEY=

# Frontend URL
FRONTEND_URL=http://localhost:5173
VITE_API_URL=http://localhost:5000/api
